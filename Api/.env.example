# Server
PORT=3001
NODE_ENV=development

# Comma-separated list of allowed frontend origins (no wildcards in production)
CORS_ORIGINS=http://localhost:3000

# Llama access — works with any OpenAI-compatible chat completions endpoint
# (Groq, Together AI, Fireworks, OpenRouter, local Ollama, etc.)
LLAMA_API_BASE_URL=https://api.groq.com/openai/v1
LLAMA_API_KEY=replace-me
LLAMA_MODEL=llama-3.3-70b-versatile

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Optional — live web search for fault codes without curated causes/symptoms
# (get a key at tavily.com). Leave SEARCH_API_KEY unset to disable; the
# assistant falls back to hedged general knowledge instead of failing to boot.
SEARCH_API_BASE_URL=https://api.tavily.com
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=3
